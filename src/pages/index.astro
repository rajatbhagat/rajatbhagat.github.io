---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import site from '../data/site.json';
import profileImg from '../assets/profile.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = await getCollection('projects');
const featuredBuild = projects.find((p) => p.id === 'ask-my-resume');
const FeaturedContent = featuredBuild ? (await render(featuredBuild)).Content : null;
---

<BaseLayout title={`${site.name} — Software Engineer`} wide>
  <section class="hero">
    <Image src={profileImg} alt={site.name} class="avatar" width={140} height={140} densities={[1, 2]} />
    <div>
      <h1>{site.heroGreeting}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="callout">{site.openToCallout}</p>
      <p class="cta">
        <a href={site.resume} class="btn" download="Rajat-Bhagat-Resume.pdf">Download Resume ↓</a>
        {site.chatEndpoint && (
          <a href="/ask-my-resume/" class="btn btn-ghost">💬 Ask My Resume</a>
        )}
      </p>
      <p class="links">
        <a href={`mailto:${site.email}`}>Email</a> ·
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
        <a href={site.github} target="_blank" rel="noopener">GitHub</a> ·
        {site.location}
      </p>
    </div>
  </section>

  {
    featuredBuild && (
      <section class="block">
        <div class="block-head">
          <h2 class="section-title">Featured build: {featuredBuild.data.name}</h2>
          <a href="/ask-my-resume/" class="link-arrow">
            Try it →
          </a>
        </div>
        <div class="card featured-card">
          <div class="featured-desc muted">{FeaturedContent && <FeaturedContent />}</div>
          <div class="tags">
            {featuredBuild.data.tech.map((t) => (
              <span class="pill">{t}</span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="block">
    <h2 class="section-title">Core stack</h2>
    <div class="stack-grid">
      {
        site.skills.map(({ group, items }) => (
          <div>
            <div class="stack-label">{group}</div>
            <div class="stack-items">{items}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="block">
    <h2 class="section-title">Highlights</h2>
    <ul class="dash-list">
      {site.highlights.map((h) => <li>{h}</li>)}
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section class="block">
        <div class="block-head">
          <h2 class="section-title">Latest from the blog</h2>
          <a href="/blog/" class="link-arrow">
            All posts →
          </a>
        </div>
        <div class="post-list">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 3rem;
    margin-top: 3rem;
    padding-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .avatar {
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--accent);
    flex-shrink: 0;
  }

  h1 {
    margin: 0 0 0.6rem;
    font-size: 2.6rem;
  }

  .tagline {
    max-width: 42rem;
    margin: 0 0 0.85rem;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .callout {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 1.15rem;
  }

  .links {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--text-faint);
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 0;
  }

  .block {
    padding-bottom: 1rem;
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .block-head .section-title {
    padding-top: 0;
    border-top: none;
    margin: 0;
  }

  .block .section-title {
    margin-bottom: 1.25rem;
  }

  .featured-desc :global(p) {
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.65;
  }

  .featured-desc :global(p:last-child) {
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .stack-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .stack-items {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text);
  }

  .post-list {
    display: grid;
    gap: 1rem;
  }
</style>
