---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const roles = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id)
);
const rendered = await Promise.all(
  roles.map(async (role) => ({ role, Content: (await render(role)).Content }))
);
const { education, certifications } = site;
---

<BaseLayout
  title={`Experience — ${site.name}`}
  description={`Professional experience of ${site.name}.`}
>
  <h1>Experience</h1>

  <div class="timeline">
    {
      rendered.map(({ role, Content }) => (
        <section class="role">
          <h2>{role.data.company}</h2>
          <div class="title">{role.data.title}</div>
          <div class="when muted">
            {role.data.period} · {role.data.location}
          </div>
          <div class="bullets">
            <Content />
          </div>
        </section>
      ))
    }
  </div>

  <div class="edu-grid">
    <div>
      <h2 class="edu-title">Education</h2>
      <div class="edu-name">{education.school}</div>
      <div class="edu-detail muted">{education.degree} · {education.detail}</div>
      <div class="edu-period muted">{education.period}</div>
    </div>
    <div>
      <h2 class="edu-title">Certifications &amp; Achievements</h2>
      <ul class="certs">
        {certifications.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  h1 {
    margin: 2.5rem 0 2.5rem;
    font-size: 2.4rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .role {
    padding-bottom: 2.75rem;
    margin-bottom: 2.75rem;
    border-bottom: 1px solid var(--border);
  }

  .role:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .role h2 {
    margin: 0 0 0.1rem;
    font-size: 1.4rem;
  }

  .title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .when {
    font-size: 0.85rem;
    margin-bottom: 0.9rem;
  }

  .bullets :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .bullets :global(li) {
    position: relative;
    padding-left: 1.4em;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .bullets :global(li)::before {
    content: '—';
    color: var(--accent);
    position: absolute;
    left: 0;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding-top: 0.5rem;
  }

  .edu-title {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
  }

  .edu-name {
    font-size: 0.98rem;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .edu-detail {
    font-size: 0.9rem;
    margin-bottom: 0.15rem;
  }

  .edu-period {
    font-size: 0.85rem;
  }

  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .certs li {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .edu-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
