---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

// Party games. The pages themselves are plain HTML in public/, so they are
// listed here by hand rather than through a content collection — one entry
// per game, add another object to grow the list.
const games = [
  {
    name: 'Baby Feud',
    blurb:
      'Family-Feud-style survey game for a baby shower. Fifteen rounds, two teams, flip-up answer board and a running scoreboard.',
    tech: ['Two screens', 'WebRTC', 'Same wifi', 'No install'],
    play: { label: 'Open the game screen', url: '/baby-feud/' },
    host: { label: 'Host panel', url: '/baby-feud/host/' },
    note: 'Put the game screen on the TV, open the host panel on your phone, and pair them with the 4-character room code. Answers stay on your phone; tapping one flips it on the big screen.',
    requirement:
      'Both devices must be on the same wifi. The phone talks to the screen directly rather than through a server, which is what keeps the answers private — but it also means a phone on mobile data usually cannot reach the screen at all.',
  },
];
---

<BaseLayout
  title={`Games — ${site.name}`}
  description="Browser party games — no install, no accounts, just open a link."
>
  <h1>Games</h1>
  <p class="muted">
    Party games that run entirely in the browser. Nothing to install, no accounts,
    no data leaving the room — just open a link.
  </p>

  <div class="grid">
    {
      games.map((game) => (
        <article class="card">
          <h2>{game.name}</h2>
          <p class="desc muted">{game.blurb}</p>
          <p class="tech">
            {game.tech.map((t) => (
              <span class="pill">{t}</span>
            ))}
          </p>
          <p class="note muted">{game.note}</p>
          <p class="requirement"><strong>Before you start:</strong> {game.requirement}</p>
          {/* New tabs: the two links are opened on different devices minutes
              apart, so losing this page in between is a needless round trip. */}
          <p class="links">
            <a class="btn" href={game.play.url} target="_blank" rel="noopener">
              {game.play.label} ↗
            </a>
            <a class="secondary" href={game.host.url} target="_blank" rel="noopener">
              {game.host.label} ↗
            </a>
          </p>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  h1 {
    margin-top: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }

  .desc {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
  }

  .note {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    line-height: 1.6;
    border-left: 2px solid var(--border);
    padding-left: 0.75rem;
  }

  /* Load-bearing: pairing simply fails if the two devices are not together. */
  .requirement {
    flex: 1;
    margin: 0 0 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
    color: var(--text);
  }

  .links {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .secondary {
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
