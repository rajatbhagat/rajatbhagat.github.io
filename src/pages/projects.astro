---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)
);
const featured = projects.slice(0, 3);
const rest = projects.slice(3);

const renderedFeatured = await Promise.all(
  featured.map(async (project) => ({ project, Content: (await render(project)).Content }))
);
const renderedRest = await Promise.all(
  rest.map(async (project) => ({ project, Content: (await render(project)).Content }))
);
---

<BaseLayout
  title={`Projects — ${site.name}`}
  description={`Selected personal and learning projects by ${site.name}.`}
  wide
>
  <h1>Projects</h1>
  <p class="intro muted">
    A selection of personal projects. More on
    <a href={site.github} target="_blank" rel="noopener">GitHub</a>.
  </p>

  <div class="featured-list">
    {
      renderedFeatured.map(({ project, Content }) => (
        <article class="card">
          <h2>{project.data.name}</h2>
          <div class="desc muted">
            <Content />
          </div>
          <p class="tech">
            {project.data.tech.map((t) => (
              <span class="pill">{t}</span>
            ))}
          </p>
          <p class="links">
            {project.data.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener">
                {link.label} ↗
              </a>
            ))}
          </p>
        </article>
      ))
    }
  </div>

  {
    renderedRest.length > 0 && (
      <>
        <button id="toggle-more" class="btn btn-outline" data-count={renderedRest.length}>
          Show more projects ({renderedRest.length})
        </button>

        <div id="more-projects" class="more-list" hidden>
          {renderedRest.map(({ project, Content }) => (
            <div class="more-item">
              <h3>{project.data.name}</h3>
              <div class="desc muted">
                <Content />
              </div>
              <p class="links">
                {project.data.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label} ↗
                  </a>
                ))}
              </p>
            </div>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>

<script>
  function initProjectsToggle() {
    const toggle = document.getElementById('toggle-more');
    const more = document.getElementById('more-projects');
    if (!toggle || !more) return;
    const count = toggle.dataset.count;
    toggle.addEventListener('click', () => {
      const showing = !more.hidden;
      more.hidden = showing;
      toggle.textContent = showing ? `Show more projects (${count})` : 'Show fewer projects';
    });
  }
  document.addEventListener('astro:page-load', initProjectsToggle);
</script>

<style>
  h1 {
    margin: 2.5rem 0 0.5rem;
    font-size: 2.4rem;
  }

  .intro {
    margin: 0 0 2.5rem;
    font-size: 1rem;
  }

  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .featured-list h2 {
    margin: 0 0 0.6rem;
    font-size: 1.35rem;
  }

  .desc :global(p) {
    margin: 0 0 1rem;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }

  .links {
    margin: 0;
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }

  .links a {
    font-weight: 600;
  }

  .btn-outline {
    background: none;
    border: 1.5px solid var(--border);
    color: var(--text);
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    margin-bottom: 1.5rem;
  }

  .btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .more-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .more-list[hidden] {
    display: none;
  }

  .more-item {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .more-item h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .more-item .desc :global(p) {
    font-size: 0.92rem;
    margin-bottom: 0.6rem;
  }

  .more-item .links {
    font-size: 0.85rem;
  }
</style>
