---
import type { CollectionEntry } from 'astro:content';
import { slugifyCategory } from '../utils/slug';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const categorySlug = slugifyCategory(post.data.category);
const dateStr = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="card">
  <div class="meta muted">
    <a href={`/blog/category/${categorySlug}/`}>{post.data.category}</a>
    <span>· {dateStr}</span>
  </div>
  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p class="muted">{post.data.description}</p>
</article>

<style>
  .meta {
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .meta a {
    color: var(--text-faint);
    font-weight: 600;
  }

  .meta a:hover {
    color: var(--accent);
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  h3 a {
    color: var(--text);
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
