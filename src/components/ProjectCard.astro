---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const dateStr = project.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<article class="card">
  <div class="meta">
    <span class="muted">{dateStr}</span>
  </div>
  <h3><a href={`/projects/${project.id}/`}>{project.data.name}</a></h3>
  <p class="muted">{project.data.description}</p>
  <p class="tech">
    {project.data.tech.map((t) => <span class="pill">{t}</span>)}
  </p>
</article>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  h3 {
    margin: 0.6rem 0 0.35rem;
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--text);
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  p {
    margin: 0;
    font-size: 0.95rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
</style>
